    "voice": {
      "principles": [
        "Precise: name the document, the field and the number",
        "Explain, don't assert: every automatic decision says which rule and which values",
        "Calm under month-end pressure; no exclamation marks, no blame",
        "Use the accounting words our users already use (PO, short-pay, credit note), never internal system terms"
      ],
      "toneByContext": [
        {
          "context": "Explanations of matches and exceptions",
          "tone": "Factual and complete: rule, values compared, tolerance"
        },
        {
          "context": "Errors",
          "tone": "Say what happened, that nothing was lost when that's true, and one next step"
        },
        {
          "context": "Success",
          "tone": "Short confirmation that names what changed and where it was recorded"
        },
        {
          "context": "Empty states",
          "tone": "Say what will appear here and how to get it there"
        },
        {
          "context": "Permissions",
          "tone": "Neutral; explain the control and who can change it"
        }
      ],
      "glossary": [
        {
          "term": "exception",
          "use": "An invoice that couldn't be matched automatically and needs a person",
          "avoid": [
            "error",
            "issue",
            "flag",
            "problem"
          ]
        },
        {
          "term": "match / matched",
          "use": "An invoice linked to its purchase order and bank payment",
          "avoid": [
            "pair",
            "link",
            "reconciled item"
          ]
        },
        {
          "term": "resolution",
          "use": "What the preparer proposes to do about an exception",
          "avoid": [
            "fix",
            "decision",
            "outcome"
          ]
        },
        {
          "term": "reviewer",
          "use": "The second person who approves a resolution",
          "avoid": [
            "approver",
            "checker",
            "admin"
          ]
        },
        {
          "term": "purchase order (PO)",
          "use": "Spell out once per screen, then PO",
          "avoid": [
            "order",
            "requisition"
          ]
        },
        {
          "term": "bank payment",
          "use": "A line from the bank statement export",
          "avoid": [
            "transaction",
            "remittance",
            "transfer"
          ]
        },
        {
          "term": "rule",
          "use": "The named, versioned criteria behind an automatic match",
          "avoid": [
            "algorithm",
            "AI",
            "model",
            "confidence",
            "score"
          ]
        }
      ]
    },
