      "toneByContext": [
        {
          "context": "Booking steps",
          "tone": "Brief and practical; one question per heading"
        },
        {
          "context": "Errors",
          "tone": "Reassuring; say what was kept, then one next step, with calling as a fallback"
        },
        {
          "context": "Policy and fees",
          "tone": "Upfront and specific, never buried; no legal language"
        },
        {
          "context": "Health questions",
          "tone": "Gentle; say why we ask and who sees the answers"
        },
        {
          "context": "Success",
          "tone": "Quiet confirmation with the key facts: when, where, who"
        }
      ],
      "glossary": [
        {
          "term": "appointment",
          "use": "A booked session at the clinic",
