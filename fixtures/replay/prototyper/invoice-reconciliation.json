    "handoff": {
      "overview": "Ledgerline helps accounts-payable teams at companies with 50–500 people match supplier invoices to purchase orders and bank payments, resolve the exceptions with evidence side by side, get a second person's approval and export an audit trail. This handoff covers the six P0 pages and Matching rules for desktop web, in light and dark mode. Every automatic decision records its rule and version and the values compared.",
      "screens": [
        {
          "screenId": "exceptions",
          "purpose": "Home page: the queue of invoices that couldn't be matched automatically, for one accounting period.",
          "behaviour": [
            "'Open next exception' opens the oldest exception in the current filter",
            "J/K or arrow keys move the selection, Enter opens it, / focuses search; single-key shortcuts only work while the list has focus",
            "Chips filter by exception type; search matches invoice number, PO number, supplier or amount",
            "Partial: a warning explains that rejected import rows may cause extra exceptions, with a link to them"
          ],
          "data": [
            "Reads exceptions for the period with reason, amount and age",
            "Reads period totals: open, matched automatically, waiting for approval, value in exceptions"
          ],
          "edgeCases": [
            "Exception resolved by a colleague while the list is open: the row is removed on the next refresh and opening it shows it was resolved",
            "Amounts in another currency show the original currency and the base-currency value"
          ],
          "acceptanceCriteria": [
            "Each row's reason names the type and both values in words",
            "Open next exception opens the oldest exception in the current filter",
            "The queue is fully usable without a mouse",
            "Loading keeps the column headers and announces 'Loading exceptions'"
          ]
        },
        {
          "screenId": "exception-detail",
          "purpose": "Resolve one exception with the invoice, purchase order and bank payment side by side.",
          "behaviour": [
            "The reason banner names the rule and the values that broke it",
            "Values that differ carry a warning icon and 'Differs' with the size of the difference",
            "Submit for approval needs a resolution and a note; missing ones are named next to the field and focus moves to the first",
            "On success, focus moves to Next exception; Ctrl+Enter submits, J opens the next exception, Esc goes back",
            "If sending fails, the resolution and note are kept and Try again is offered"
          ],
          "data": [
            "Reads the invoice, PO lines with quantity received, and any linked bank payment",
            "Writes the resolution, note, author and time; creates an audit event"
          ],
          "edgeCases": [
            "No payment found yet: the payment card says so",
            "The PO has several partial receipts: all receipt dates are listed",
            "Another person resolves the same exception first: show who and when, and stop the second submission"
          ],
          "acceptanceCriteria": [
            "A resolution can't be submitted without a note",
            "Every differing value is identifiable without colour",
            "After submitting, pressing Enter opens the next exception"
          ]
        },
        {
          "screenId": "matches",
          "purpose": "Spot-check automatic and reviewer matches and see exactly why each was made.",
          "behaviour": [
            "Selecting a row shows the rule, its version and the date, then each field compared (supplier, PO number, amount, payment reference) as Same or Within tolerance, then the tolerance applied",
            "Mark as checked records a spot check with the reviewer's name and selects the next row",
            "Unmatch and review moves the invoice back to Exceptions; the original match stays in the audit trail"
          ],
          "data": [
            "Reads matched sets with rule id, rule version and the compared values",
            "Writes spot checks and unmatches as audit events"
          ],
          "edgeCases": [
            "Rule changed since the match: the explanation shows the version used at the time",
            "Match made by a reviewer rather than a rule: show the person and the approved resolution instead"
          ],
          "acceptanceCriteria": [
            "No match is shown without its rule, version and compared values",
            "Checking a match creates an audit event naming the reviewer"
          ]
        },
        {
          "screenId": "approvals",
          "purpose": "Second-person approval of proposed resolutions.",
          "behaviour": [
            "Approve resolution resolves the exception and records the approver",
            "Send back with comment requires a comment and notifies the preparer by email",
            "Resolutions the signed-in person proposed can be read but not approved; the reason is shown",
            "People without the Reviewer role see the permission state"
          ],
          "data": [
            "Reads resolutions waiting, with evidence summary, note and proposer",
            "Writes approvals and returns with comments"
          ],
          "edgeCases": [
            "The only reviewer is also the preparer: the resolution waits until another reviewer is added",
            "Resolution withdrawn while being reviewed"
          ],
          "acceptanceCriteria": [
            "A person can never approve their own resolution",
            "Every approval and return creates an audit event",
            "Single-key shortcuts only work while the list or selected resolution has focus"
          ]
        },
        {
          "screenId": "import",
          "purpose": "Import invoices, purchase orders and bank payments from CSV files for a period.",
          "behaviour": [
            "Every row is checked (dates, amounts, currency codes, required columns) before matching",
            "Valid rows are imported and matched even if some are rejected",
            "Rejected rows are listed with the file, row number and reason, and can be downloaded as CSV",
            "Column mapping is saved per file type"
          ],
          "data": [
            "Reads CSV files up to 20 MB each",
            "Writes imported rows, rejected rows with reasons, and an import audit event"
          ],
          "edgeCases": [
            "The same file imported twice: rows already imported are skipped and counted",
            "Mixed date formats in one file",
            "Files from different periods"
          ],
          "acceptanceCriteria": [
            "One bad row never blocks the rest of the file",
            "Each rejected row names its file, row number and reason",
            "A file that can't be read is named in the error"
          ]
        },
        {
          "screenId": "audit-export",
          "purpose": "Every import, match, resolution and approval for a period, and the export for auditors.",
          "behaviour": [
            "Events newest first, filterable by type",
            "Each event shows time, person or rule and version, and the values compared",
            "Export creates a CSV (one row per event) or a PDF summary for the chosen period"
          ],
          "data": [
            "Reads audit events for the period",
            "Writes an export file and an export audit event"
          ],
          "edgeCases": [
            "Very large periods: export runs in the background and the page says when it's ready",
            "Events from a rule version that has since changed"
          ],
          "acceptanceCriteria": [
            "The CSV export alone lets an auditor trace any match or resolution to its rule or person and the values compared",
            "Exporting is itself recorded in the audit trail"
          ]
        },
        {
          "screenId": "rules",
          "purpose": "Read the rules and tolerances that drive automatic matching.",
          "behaviour": [
            "Lists each rule with its id, criteria, tolerance and current version",
            "Rule history downloads as CSV"
          ],
          "data": [
            "Reads rules and their version history"
          ],
          "edgeCases": [
            "A rule is retired: it stays listed as retired so past matches can still be traced"
          ],
          "acceptanceCriteria": [
            "Every rule id used in a match explanation appears on this page"
          ]
        }
      ],
