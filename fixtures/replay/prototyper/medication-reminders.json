    "handoff": {
      "overview": "Dose helps adults who manage several daily medications, and the carers who support them, take the right dose at the right time. This handoff covers the first-release P0 screens (Today, Add medication, Dose reminder, History) and the Family tab, on iOS and Android, in light and dark mode.",
      "screens": [
        {
          "screenId": "today",
          "purpose": "Today's doses and their status; answer the next one.",
          "behaviour": [
            "'Mark as taken' records the next due dose with the current time and shows the confirmation with Undo for 10 s (paused while focused).",
            "Tapping a due dose opens the Dose reminder sheet.",
            "Offline: answers are stored locally and shown with 'Waiting to sync' until confirmed by the server."
          ],
          "data": [
            "Reads today's schedule and answers",
            "Writes dose answers (taken, skipped, snoozed) with timestamps"
          ],
          "edgeCases": [
            "Two doses due at the same time: the card shows the earliest; the list shows both",
            "Device time zone changes while travelling"
          ],
          "acceptanceCriteria": [
            "Marking a dose shows the confirmation within 300 ms, even offline",
            "Undo restores the dose to Due and removes the answer",
            "Rows answered offline show 'Waiting to sync' until synced"
          ]
        },
        {
          "screenId": "add-medication",
          "purpose": "Add a medication with dose and schedule in under a minute.",
          "behaviour": [
            "Only name, dose and one time are required",
            "Errors show next to each field; the first invalid field gets focus",
            "Save keeps entries if it fails"
          ],
          "data": [
            "Writes medication, dose and schedule"
          ],
          "edgeCases": [
            "Duplicate medication name",
            "Times entered in 12- or 24-hour format"
          ],
          "acceptanceCriteria": [
            "A new medication can be added with keyboard or switch control only",
            "A failed save never loses entered data"
          ]
        },
        {
          "screenId": "dose-reminder",
          "purpose": "Answer a due dose from the notification or Today.",
          "behaviour": [
            "Opens as a bottom sheet; focus moves to the title and the screen behind is inert",
            "Snooze schedules a new reminder in 10 minutes",
            "The reminder stays until answered"
          ],
          "data": [
            "Writes the answer for one dose"
          ],
          "edgeCases": [
            "Answering a dose from a notification after it was answered on another device"
          ],
          "acceptanceCriteria": [
            "The sheet can be answered with one tap from the notification on iOS and Android",
            "On close, focus returns to the dose on Today"
          ]
        },
        {
          "screenId": "history",
          "purpose": "See past doses by day.",
          "behaviour": [
            "Filters by this week or this month",
            "Loading is announced to screen readers"
          ],
          "data": [
            "Reads past answers"
          ],
          "edgeCases": [
            "Long gaps with no doses",
            "Medication deleted after doses were recorded"
          ],
          "acceptanceCriteria": [
            "History shows each dose with its answer and time",
            "Empty history explains what will appear"
          ]
        },
        {
          "screenId": "carer-overview",
          "purpose": "People you follow and whether their doses are on track.",
          "behaviour": [
            "Unmarked doses are listed first"
          ],
          "data": [
            "Reads followed people's dose status (with their consent)"
          ],
          "edgeCases": [
            "Consent withdrawn while the screen is open"
          ],
          "acceptanceCriteria": [
            "Only people who invited you are shown"
          ]
        }
      ],
      "components": [
        {
          "name": "Buttons",
          "notes": "Material 3 Button (filled, outlined, text) on Android; filled, tinted and plain on iOS. Minimum target 48dp / 44pt."
        },
        {
          "name": "Confirmation with Undo",
          "notes": "Custom banner in primaryContainer; polite live region; 10 s timer that pauses on focus."
        },
        {
          "name": "Dose reminder sheet",
          "notes": "Material bottom sheet / iOS sheet with a grabber; inert background."
        }
      ],
      "accessibility": [
        "Text follows the system text size; layouts reflow up to the largest Dynamic Type and font scale",
        "Status is always shown with an icon and words, not colour alone",
        "Loading states and confirmations are announced politely",
        "Focus moves into sheets and modals and returns on close"
      ],
      "analytics": [
        "dose_answered (answer, source: notification | today, offline)",
        "dose_undone",
        "medication_added"
      ],
