    "journeys": [
      {
        "id": "J1",
        "persona": "The new patient in pain",
        "goal": "Book a first assessment soon, without phoning",
        "stages": [
          {
            "stage": "Discover",
            "actions": [
              "Searches for a physio nearby on a phone",
              "Lands on the clinic's booking page"
            ],
            "painPoints": [
              "Clinic is closed, so calling isn't an option",
              "Unsure which appointment type to choose"
            ],
            "opportunities": [
              "Open straight on 'Book an appointment' with a plain hint on which type to pick"
            ]
          },
          {
            "stage": "Book",
            "actions": [
              "Picks Initial assessment and a clinic",
              "Takes the first available time",
              "Enters name, mobile and email"
            ],
            "painPoints": [
              "Dense time grids and small targets",
              "Worry about being charged if they can't make it"
            ],
            "opportunities": [
              "First available by default; large time rows; policy stated before confirming; time held while they type"
            ]
          },
          {
            "stage": "Prepare",
            "actions": [
              "Gets a confirmation",
              "Answers a few intake questions",
              "Gets a reminder the day before"
            ],
            "painPoints": [
              "Paper forms in the waiting room",
              "Not knowing where to go or whether there are stairs"
            ],
            "opportunities": [
              "Short intake straight after booking or from the reminder; access details on the confirmation"
            ]
          }
        ]
      },
      {
        "id": "J2",
        "persona": "The returning patient mid-treatment",
        "goal": "Keep weekly follow-ups on track around work",
        "stages": [
          {
            "stage": "Plan",
            "actions": [
              "Opens the app or a reminder link",
              "Books the next follow-up with the same physio"
            ],
            "painPoints": [
              "Their physio's times fill quickly"
            ],
            "opportunities": [
              "Show their physio first; offer anyone available when there are no times"
            ]
          },
          {
            "stage": "Change",
            "actions": [
              "Something comes up",
              "Moves the appointment to another day"
            ],
            "painPoints": [
              "Has to call reception in working hours"
            ],
            "opportunities": [
              "Change date or time online up to 24 hours before"
            ]
          },
          {
            "stage": "Late change",
            "actions": [
              "Needs to cancel the morning of the appointment"
            ],
            "painPoints": [
              "Doesn't know what it will cost",
              "Can't change it online"
            ],
            "opportunities": [
              "Explain the 24-hour policy and fee plainly and offer a one-tap call"
            ]
          }
        ]
      }
    ],
