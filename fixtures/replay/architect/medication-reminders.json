        "steps": [
          "Tap Add medication on the empty Today screen",
          "Enter name, dose and times",
          "Save",
          "See the doses on Today"
        ]
      },
      {
        "id": "F2",
        "name": "Answer a dose reminder",
        "trigger": "A dose is due",
