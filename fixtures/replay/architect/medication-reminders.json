    "journeys": [
      {
        "id": "J1",
        "persona": "The juggling self-manager",
        "goal": "Take every dose on time and keep the plan current",
        "stages": [
          {
            "stage": "Set up",
            "actions": [
              "Installs the app",
              "Adds each medication with dose and times"
            ],
            "painPoints": [
              "Typing several medications is tedious"
            ],
            "opportunities": [
              "Add one medication in under a minute; add more later from Today"
            ]
          },
          {
            "stage": "Daily use",
            "actions": [
              "Gets a reminder",
              "Marks the dose as taken, skipped or snoozed"
            ],
            "painPoints": [
              "Alarms don't record anything"
            ],
            "opportunities": [
              "Answer from the reminder in one tap"
            ]
          },
          {
            "stage": "Check",
            "actions": [
              "Wonders whether the morning dose was taken",
              "Opens Today or History"
            ],
            "painPoints": [
              "Risk of a double dose"
            ],
            "opportunities": [
              "Today shows each dose's answer at a glance"
            ]
          },
          {
            "stage": "Change",
            "actions": [
              "Doctor changes a dose",
              "Updates that medication from a date"
            ],
            "painPoints": [
              "Re-entering the whole schedule"
            ],
            "opportunities": [
              "Change one medication from a date, keeping history"
            ]
          }
        ]
      },
      {
        "id": "J2",
        "persona": "The remote carer",
        "goal": "Know a parent's doses are on track without calling",
        "stages": [
          {
            "stage": "Connect",
            "actions": [
              "Parent invites them from Family",
              "Accepts the invitation"
            ],
            "painPoints": [
              "Consent must be clear to both"
            ],
            "opportunities": [
              "Plain explanation of what is shared, and how to stop"
            ]
          },
          {
            "stage": "Stay informed",
            "actions": [
              "Gets an alert only when a dose isn't marked",
              "Opens Family to see today"
            ],
            "painPoints": [
              "Too many alerts feel like surveillance"
            ],
            "opportunities": [
              "Alert on missed doses only, with a calm tone"
            ]
          }
        ]
      }
    ],
